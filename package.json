{
  "name": "snippet-notes",
  "version": "0.7.2",
  "description": "效能笔记,碎片笔记记录软件,与同类型笔记相比，主要对搜索及速记能力进行优化",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --dir",
    "arm": "electron-builder --linux --arm64 --dir",
    "linux.x86": "electron-builder --linux --x64 --dir"
  },
  "author": "xunxun10",
  "license": "MIT",
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.4.0",
    "node-gyp": "^9.4.0"
  },
  "dependencies": {
    "diff": "^5.1.0",
    "fs-extra": "^11.1.1",
    "ini": "^4.1.1",
    "sqlite3": "^5.1.6",
    "winston": "^3.9.0"
  },
  "build": {
    "appId": "snippet-notes@xunxun10",
    "productName": "snippet-notes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/.vscode/**",
      "!*.sh",
      "!*.md",
      "!*.lock",
      "!dist.files.md5*.txt",
      "!change_log.txt",
      "!.gitignore"
    ],
    "asar": true,
    "afterPack": "scripts/afterPack.js",
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "nsis": {
      "shortcutName": "snipnote",
      "oneClick": false,
      "allowElevation": true,
      "installerIcon": "res/img/snippet-notes.ico",
      "uninstallerIcon": "res/img/snippet-notes.ico",
      "installerHeaderIcon": "res/img/snippet-notes.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": "dir",
      "icon": "res/img/snippet-notes.ico"
    },
    "linux":{
      "target": "dir",
      "icon": "res/img/snippet-notes.png"
    },
    "extraResources": [
      {
        "from": "res/img",
        "to": "icon",
        "filter": ["snippet-notes.ico", "snippet-notes.png", "snippet-notes-file.ico", "snippet-notes-file.png"]
      }
    ]
  },
  "keywords": []
}
